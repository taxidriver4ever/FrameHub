# Local environment and credentials (keep the safe configuration template)
.env
.env.*
!.env.example
secrets/
.secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Maven / Java build output
target/
*.class
*.jar
*.war
*.ear
*.nar
!.mvn/wrapper/maven-wrapper.jar
.flattened-pom.xml
dependency-reduced-pom.xml
hs_err_pid*
replay_pid*
*.hprof

# Local tools, media scratch space and runtime logs
/.tools/
/.video-work/
logs/
*.log
*.pid
*.pid.lock

# Python helpers and optional frontend tooling
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
node_modules/
coverage/
.nyc_output/
/frontend/dist/

# Editor and operating-system files
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Local archives; source, migrations, API snapshots and validation evidence remain tracked
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
