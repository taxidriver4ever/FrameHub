# Copy to .env and replace every CHANGE_ME value. Never commit .env.
MYSQL_ROOT_PASSWORD=CHANGE_ME_RANDOM_ROOT_PASSWORD
DB_PASSWORD=CHANGE_ME_RANDOM_DB_PASSWORD
DB_USERNAME=framehub
DB_URL=jdbc:mysql://127.0.0.1:13306/framehub?connectionTimeZone=UTC
REDIS_PASSWORD=CHANGE_ME_RANDOM_REDIS_PASSWORD
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
# Base64 encoded random bytes, at least 32 bytes (see scripts/init-local.ps1)
JWT_SECRET=CHANGE_ME_BASE64_RANDOM_32_BYTES
CODE_SECRET=CHANGE_ME_RANDOM_32_BYTES
WORKER_ID=1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:28080
USER_SERVICE_URL=http://127.0.0.1:8081
MINIO_ENDPOINT=http://localhost:19000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=avatars
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=noreply@framehub.local
RESET_URL=http://localhost:3000/reset-password
SPRING_PROFILES_ACTIVE=local
TRUST_GATEWAY=false

VIDEO_DB_URL=jdbc:mysql://127.0.0.1:13306/framehub_video?connectionTimeZone=UTC
VIDEO_DB_USERNAME=framehub_video
VIDEO_DB_PASSWORD=CHANGE_ME_VIDEO_DATABASE_PASSWORD
CANAL_PASSWORD=CHANGE_ME_CANAL_PASSWORD
VIDEO_BUCKET=videos
VIDEO_SERVICE_URL=http://127.0.0.1:8082
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# Production defaults fail closed. compose.local.yml explicitly enables local Mock.
PAYMENT_PROVIDER=DISABLED
WITHDRAWAL_PROVIDER=DISABLED
COMMERCE_CONSUMER_ENABLED=false
COMMERCE_JOBS_ENABLED=false
GATEWAY_RATE_LIMIT_ENABLED=true
MAX_PENDING_ORDERS=5
DAILY_CANCELLATION_LIMIT=10
ORDER_TTL=15m
DOWNLOAD_TTL=2m
# Only configure after real merchant onboarding. Mount PEM files read-only yourself.
WECHAT_ENABLED=false
WECHAT_MERCHANT_ID=
WECHAT_APP_ID=
WECHAT_MERCHANT_SERIAL=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_PLATFORM_KEY_ID=
WECHAT_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_API_V3_KEY=
WECHAT_NOTIFY_URL=

GATEWAY_PORT=28080
