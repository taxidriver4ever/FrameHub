  "components": {
    "schemas": {
      "Password": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 72,
            "minLength": 0
          },
          "newPassword": {
            "type": "string",
            "maxLength": 72,
            "minLength": 10
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "ApiResponseObject": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        }
      },
      "Avatar": {
        "type": "object",
        "properties": {
          "objectKey": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          }
        },
        "required": [
          "objectKey"
        ]
      },
      "Upload": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "contentType": {
            "type": "string",
            "minLength": 1
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64",
            "maximum": 2097152,
            "minimum": 1
          }
        },
        "required": [
          "contentType",
          "filename"
        ]
      },
      "Register": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 10
          },
          "verificationCode": {
            "type": "string",
            "minLength": 1,
            "pattern": "[0-9]{6}"
          },
          "nickname": {
            "type": "string",
            "maxLength": 64,
            "minLength": 0
          }
        },
        "required": [
          "email",
          "nickname",
          "password",
          "verificationCode"
        ]
      },
      "Reset": {
        "type": "object",
        "properties": {
          "resetToken": {
            "type": "string",
            "maxLength": 128,
            "minLength": 0
          },
          "newPassword": {
            "type": "string",
            "maxLength": 72,
            "minLength": 10
          }
        },
        "required": [
          "newPassword",
          "resetToken"
        ]
      },
      "Forgot": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          }
        },
        "required": [
          "email"
        ]
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 0
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "EmailCode": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "scene": {
            "type": "string",
            "pattern": "REGISTER"
          }
        },
        "required": [
          "email",
          "scene"
        ]
      },
      "JsonNode": {}
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
